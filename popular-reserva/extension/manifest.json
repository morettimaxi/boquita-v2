{
  "manifest_version": 3,
  "name": "Boca Socios - Cookie Manager",
  "version": "1.1.3",
  "description": "Inyecta cookies de Queue-it para acceder a Boca Socios sin cola",
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://bocasocios.bocajuniors.com.ar/*",
    "https://bocasocios-gw.bocajuniors.com.ar/*",
    "https://*.bocajuniors.com.ar/*",
    "https://boca-cookies.rosaleseze86.workers.dev/*",
    "https://*.queue-it.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://boca-cookies.rosaleseze86.workers.dev/go/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://bocasocios.bocajuniors.com.ar/*"],
    "js": ["ls.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Boca Socios Cookies"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "boca-cookies@local",
      "strict_min_version": "121.0"
    }
  }
}
